# Neon Postgres. DATABASE_URL_UNPOOLED (direct connection) is used by
# drizzle-kit for migrations; falls back to DATABASE_URL if unset.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin auth
SESSION_SECRET=              # random 32+ byte secret, e.g. `openssl rand -base64 32`
ADMIN_EMAILS=you@qualfm.ie   # comma-separated allow-list

# Resend (contact form + magic-link email)
RESEND_API_KEY=
CONTACT_TO_EMAIL=service@qualfm.ie
CONTACT_FROM_EMAIL=QualFM Website <onboarding@resend.dev>

# Vercel Blob (admin image uploads) — set automatically when Blob is
# connected to the Vercel project; only needed locally
BLOB_READ_WRITE_TOKEN=

# Fixed origin used for links generated server-side (e.g. the magic-link
# email). Falls back to the request's Host header if unset.
SITE_URL=https://www.qualfm.ie
